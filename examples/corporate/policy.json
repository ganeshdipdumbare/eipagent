{
  "allow": [],
  "deny": ["creator", "sandbox_local"],
  "grants": {
    "*": [],
    "model_anthropic": ["net"], "model_openai": ["net"], "tool_fetch": ["net"],
    "audit_file": ["fs:read", "fs:write"],
    "secrets_env": ["env", "env:secrets"],
    "sandbox_docker": ["exec"],
    "db_sql": ["db"], "threads_sql": ["db"], "memory_sql": ["db"]
  },
  "locked": ["policy", "audit_file", "secrets_env"],
  "require": [
    { "use": "audit_file", "config": { "path": "/var/log/kiln/audit.jsonl" } },
    { "use": "secrets_env", "config": {
        "allow": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY", "KILN_DATABASE_URL"],
        "grants": { "model_openai": ["OPENAI_API_KEY"], "model_anthropic": ["ANTHROPIC_API_KEY"], "db_sql": ["KILN_DATABASE_URL"] } } },
    { "use": "policy" }
  ],
  "rules": {
    "mode": "workspace-write",
    "require_sandbox": true,
    "allow_models": ["anthropic:*", "openai:gpt-4.1*"],
    "deny_tools": ["*delete*", "*remove*", "*drop*", "*destroy*"],
    "max_tokens_run": 400000,
    "roles": { "analyst": { "mode": "read-only" } }
  }
}
