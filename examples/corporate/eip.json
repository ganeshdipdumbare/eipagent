{
  "model": "anthropic:claude-sonnet-5-5",
  "instructions": "You are the internal engineering assistant. Follow company policy.",
  "max_steps": 30,
  "plugins": [
    { "use": "llm_anthropic", "as": "llm_anthropic" },
    { "use": "llm_openai", "as": "llm_openai" },
    { "use": "mw_retry" },
    { "use": "mw_fallback", "config": { "models": ["openai:gpt-4.1"] } },
    { "use": "mw_pii", "config": { "types": ["email", "credit_card"], "tool_results": true } },
    { "use": "mw_auto_review", "config": { "model": "anthropic:claude-haiku-5-5" } },
    { "use": "mw_hitl", "config": { "non_readonly": true } },
    { "use": "mw_limits", "config": { "model_calls_run": 40, "tool_calls_run": 80 } },
    { "use": "db_sql", "config": { "dsn": "secret://EIP_DATABASE_URL" } },
    { "use": "checkpoint_sql" },
    { "use": "store_sql" },
    { "use": "memory_store" },
    { "use": "sandbox_docker", "config": { "image": "internal-registry/agent-runtime:1.4" } },
    { "use": "exec_sandbox", "config": { "provider": "docker", "network": "none", "memory_mb": 2048 } },
    { "use": "tool_shell" },
    { "use": "tool_fs" },
    { "use": "tool_http_fetch", "config": { "allow_hosts": ["docs.internal.example.com", "*.wikipedia.org"] } },
    { "use": "trace_file", "config": { "path": "/var/log/eipagent/trace.jsonl" } }
  ]
}
