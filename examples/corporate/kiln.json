{
  "model": "anthropic:claude-sonnet-5-5",
  "instructions": "You are the internal engineering assistant. Follow company policy.",
  "max_steps": 30,
  "modules": [
    { "use": "model_anthropic", "as": "model_anthropic" },
    { "use": "model_openai", "as": "model_openai" },
    { "use": "hook_retry" },
    { "use": "hook_fallback", "config": { "models": ["openai:gpt-4.1"] } },
    { "use": "hook_pii", "config": { "types": ["email", "credit_card"], "tool_results": true } },
    { "use": "hook_review", "config": { "model": "anthropic:claude-haiku-5-5" } },
    { "use": "hook_approval", "config": { "non_readonly": true } },
    { "use": "hook_limits", "config": { "model_calls_run": 40, "tool_calls_run": 80 } },
    { "use": "db_sql", "config": { "dsn": "secret://KILN_DATABASE_URL" } },
    { "use": "threads_sql" },
    { "use": "memory_sql" },
    { "use": "tool_memory" },
    { "use": "sandbox_docker", "config": { "image": "internal-registry/agent-runtime:1.4" } },
    { "use": "workspace_sandbox", "config": { "provider": "docker", "network": "none", "memory_mb": 2048 } },
    { "use": "tool_shell" },
    { "use": "tool_fs" },
    { "use": "tool_fetch", "config": { "allow_hosts": ["docs.internal.example.com", "*.wikipedia.org"] } },
    { "use": "trace_file", "config": { "path": "/var/log/kiln/trace.jsonl" } }
  ]
}
